{
  "name": "dsh-kicad-tool",
  "version": "0.6.0",
  "description": "KiCad tooling for DeepSeek Harness: exposes the kct CLI (kicad-tools) as agent tools for schematic/PCB inspection, DRC/ERC, BOM and authoring workflows.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib/**",
    "client.js",
    "assets/**",
    "locale/**",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs && node test/contract.mjs && node test/preview.mjs && node test/events.mjs && node test/settings.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:contract": "node test/contract.mjs",
    "test:preview": "node test/preview.mjs",
    "test:events": "node test/events.mjs",
    "test:settings": "node test/settings.mjs",
    "vendor:kicanvas": "node scripts/vendor-kicanvas.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "kicad",
    "kicad-tools",
    "kct",
    "pcb",
    "eda",
    "drc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurence-feng/dsh-kicad-tool.git"
  },
  "bugs": {
    "url": "https://github.com/laurence-feng/dsh-kicad-tool/issues"
  },
  "homepage": "https://github.com/laurence-feng/dsh-kicad-tool#readme"
}
